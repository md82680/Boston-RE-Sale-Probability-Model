FROM python:3.12-slim

WORKDIR /app

# Copy requirements first for better caching
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Install monitoring requirements for production
COPY requirements-monitoring.txt .
RUN pip install --no-cache-dir -r requirements-monitoring.txt

# Note: Don't install dev requirements in production

# Copy the rest of the application
COPY . .

# Create necessary directories
RUN mkdir -p logs marketing monitoring/metrics visualizations/performance

# Expose the API port
EXPOSE 8000

# Command to run the API
CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]
